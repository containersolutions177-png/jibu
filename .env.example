
# Jibu environment
ENVIRONMENT=demo
JIBU_DEMO_MODE=true

# Set this to your deployed frontend origin in production.
# For multiple origins, use comma-separated HTTPS origins.
FRONTEND_ORIGINS=*

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayFast — South Africa
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Ozow — South Africa
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=

# Stitch — South Africa
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=

# Peach Payments — South Africa
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=

# PayPal — Global
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
